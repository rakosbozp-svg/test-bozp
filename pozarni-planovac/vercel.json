{
 "installCommand": "npm ci --omit=dev",
 "buildCommand": "node tools/sestav_web.mjs",
 "outputDirectory": "web",
 "framework": null,
 "functions": {
  "api/claude.js": {
   "maxDuration": 300
  }
 },
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Robots-Tag",
     "value": "noindex, nofollow"
    },
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "Referrer-Policy",
     "value": "same-origin"
    }
   ]
  }
 ]
}
